# Required for Supabase auth, storage, database access, and tracking.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for absolute URLs in local/deployed environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote/model upload bucket.
NEXT_PUBLIC_SUPABASE_QUOTE_BUCKET=quote-models

# Optional app settings.
ADMIN_EMAIL=admin@example.com

# Meta / Facebook Commerce Integration.
META_SYSTEM_USER_TOKEN=
META_CATALOG_ID=
NEXT_PUBLIC_META_PIXEL_ID=1704113340670109
META_BUSINESS_ID=
META_APP_ID=
META_CAPI_USER_AGENT=flux3d-server

# Optional integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OPENAI_MODEL=gpt-4.1-mini
WHATSAPP_API_VERSION=v22.0
WHATSAPP_CLASSIFIER_MODEL=gpt-4o-mini
WHATSAPP_REPLY_TO_ALL=true
WHATSAPP_RAG_ENABLED=true
WHATSAPP_EMBEDDING_MODEL=text-embedding-3-small
WHATSAPP_RAG_TOP_K=4
WHATSAPP_RAG_MIN_SCORE=0.3
WHATSAPP_RAG_CONFIDENCE_THRESHOLD=0.55
WHATSAPP_SESSION_TURNS=4
WHATSAPP_STRUCTURED_DATA_ENABLED=true

# Razorpay payment configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
RAZORPAY_PAYMENTS_ENABLED=true

# WhatsApp webhook verification.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Sentry error monitoring (optional — leave empty to disable).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Admin diagnostics (set to true only in local development).
ADMIN_DEBUG_MODE=false

# Upstash Redis for rate limiting (optional — falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication — all /api/cron/* endpoints validate this bearer token.
CRON_SECRET=

# Supabase Database Webhook secret — validated by /api/webhooks/supabase-product-sync
SUPABASE_WEBHOOK_SECRET=

# Set to false to disable automatic knowledge sync in test environments
WHATSAPP_SYNC_ENABLED=true

# ============================================================================
# Resend ESP (Transactional Email)
# ============================================================================
# Primary API key for sending emails via Resend.
RESEND_API_KEY=

# Webhook secret for verifying incoming Resend webhook signatures (Svix).
RESEND_WEBHOOK_SECRET=

# ============================================================================
# Upstash QStash (Serverless Message Queue)
# ============================================================================
# Token from Upstash Console → QStash tab.
QSTASH_TOKEN=

# QStash URL for your region.
# https://qstash.us-east-1.upstash.io
QSTASH_URL=

# Current and next signing keys for verifying QStash push signatures.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
