# Required for Supabase auth, storage, database access, and tracking.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CSP nonce used for the Content-Security-Policy header and inline JSON-LD
# scripts. IMPORTANT: in production set this to a long random string and
# rotate it per deployment (a static, publicly-known fallback makes the CSP
# trivially bypassable).
CSP_NONCE=change-me-to-a-64-char-random-string

# Required for absolute URLs in local/deployed environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote/model upload bucket.
NEXT_PUBLIC_SUPABASE_QUOTE_BUCKET=quote-models

# Google Identity Services (One Tap / Sign-In Button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional app settings.
ADMIN_EMAIL=admin@example.com

# Meta / Facebook Commerce Integration.
META_SYSTEM_USER_TOKEN=
META_CATALOG_ID=1770810297426550
NEXT_PUBLIC_META_PIXEL_ID=
META_BUSINESS_ID=967448766213920
META_APP_ID=1687599535712574
META_CAPI_USER_AGENT=flux3d-server
# Meta Conversions API (CAPI) Gateway relay hosts allowed by the CSP
# `connect-src` directive. Space or comma separated HTTPS origins. These are
# assigned per ad account in Meta Events Manager and can be re-provisioned by
# Meta — when that happens, add the new host(s) here. Invalid entries are
# ignored safely; current defaults are built into src/lib/csp-allowlist.ts.
NEXT_PUBLIC_META_CAPI_GATEWAY_HOSTS=

# Optional integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OPENAI_MODEL=gpt-4.1-mini
WHATSAPP_API_VERSION=v22.0
WHATSAPP_CLASSIFIER_MODEL=gpt-4o-mini
WHATSAPP_REPLY_TO_ALL=true
WHATSAPP_RAG_ENABLED=true
WHATSAPP_EMBEDDING_MODEL=text-embedding-3-small
WHATSAPP_RAG_TOP_K=4
WHATSAPP_RAG_MIN_SCORE=0.3
WHATSAPP_RAG_CONFIDENCE_THRESHOLD=0.55
WHATSAPP_SESSION_TURNS=4
WHATSAPP_STRUCTURED_DATA_ENABLED=true

# WhatsApp HSM Templates (create these in Meta WhatsApp Manager, then paste names here)
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=
WHATSAPP_TEMPLATE_PAYMENT_LINK=
WHATSAPP_TEMPLATE_CONNECTED=
WHATSAPP_TEMPLATE_LANGUAGE=en_IN

# WhatsApp Flow (created via scripts/create-address-flow.mjs)
WHATSAPP_ADDRESS_FLOW_ID=

# WhatsApp Business Account ID (needed for flow creation)
WHATSAPP_WABA_ID=1464389558768847

# Razorpay payment configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
RAZORPAY_PAYMENTS_ENABLED=true

# WhatsApp webhook verification.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTH_TEMPLATE_NAME=
WHATSAPP_WEBHOOK_SECRET=

# Sentry error monitoring (optional — leave empty to disable).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Admin diagnostics (set to true only in local development).
ADMIN_DEBUG_MODE=false

# Upstash Redis for rate limiting (optional — falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication — all /api/cron/* endpoints validate this bearer token.
CRON_SECRET=

# Supabase Database Webhook secret — validated by /api/webhooks/supabase-product-sync
SUPABASE_WEBHOOK_SECRET=

# Shiprocket fulfilment integration (see /api/webhooks/fulfilment).
# x-api-key token set in Shiprocket panel: Settings > Additional Settings > Webhooks.
SHIPROCKET_EMAIL=flux3d.shipment@gmail.com
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=work-1
SHIPROCKET_WEBHOOK_SECRET=

# Set to false to disable automatic knowledge sync in test environments
WHATSAPP_SYNC_ENABLED=true

# ============================================================================
# Resend ESP (Transactional Email)
# ============================================================================
# Primary API key for sending emails via Resend.
RESEND_API_KEY=

# Webhook secret for verifying incoming Resend webhook signatures (Svix).
RESEND_WEBHOOK_SECRET=

# ============================================================================
# Upstash QStash (Serverless Message Queue)
# ============================================================================
# Token from Upstash Console → QStash tab.
QSTASH_TOKEN=

# QStash URL for your region.
# https://qstash.us-east-1.upstash.io
QSTASH_URL=

# Current and next signing keys for verifying QStash push signatures.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
